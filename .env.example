# Required for signing authentication tokens; use a unique random value at least 32 characters long.
SECRET_KEY=

# Optional; enables resume analysis, RAG answers, and job matching.
HUGGINGFACE_TOKEN=

# Optional. Defaults to the existing career_platform.db in this project directory.
DATABASE_URL=

# Optional. Comma-separated frontend origins; defaults to localhost and 127.0.0.1 on port 5500.
CORS_ORIGINS=

# Optional. Defaults to ./chroma_db and all-MiniLM-L6-v2.
CHROMA_PERSIST_DIR=
EMBEDDING_MODEL=
